# Minimal stub for the part of h5py this package uses (h5py ships no type information).
from collections.abc import KeysView
from pathlib import Path
from typing import Any, Self

class AttributeManager:
    def get(self, name: str, default: Any = None) -> Any: ...
    def __getitem__(self, name: str) -> Any: ...
    def __setitem__(self, name: str, value: Any) -> None: ...

class Dataset:
    attrs: AttributeManager
    def __getitem__(self, key: Any) -> Any: ...

class Group:
    attrs: AttributeManager
    def keys(self) -> KeysView[str]: ...
    def get(self, name: str) -> Group | Dataset | None: ...
    def create_group(self, name: str) -> Group: ...
    def __contains__(self, name: str) -> bool: ...
    def __getitem__(self, name: str) -> Group | Dataset: ...
    def __setitem__(self, name: str, value: Any) -> None: ...
    def __delitem__(self, name: str) -> None: ...

class File(Group):
    def __init__(self, name: str | Path, mode: str = "r") -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *args: object) -> None: ...
