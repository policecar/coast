{
    "datasets": {
        "mnist": {
            "default": {
                "image_file": "./data/mnist/train-images-idx3-ubyte",
                "label_file": "./data/mnist/train-labels-idx1-ubyte",
                "change_interval": 1,
                "noise_range": [
                    0.0,
                    0.05
                ],
                "random_seed": 0,
                "shuffle": false
            }
        }
    },
    "ngm3": {
        "neuron_groups": {
            "L4-mnist-ngm3": {
                "neuron_cnt": 50,
                "apical_cnt": 0,
                "proximal_cnt": 5,
                "max_branch_level": 3,
                "permanence_threshold": 0.3,
                "local_inhibition_strength": 10.0,
                "stochastic_win_thres": 0.8,
                "weight_filter": {
                    "steepness": 0.5,
                    "transition_point": 0.33
                },
                "common_learning_rate": 0.0001,
                "primary_learning_rate": 0.01,
                "secondary_learning_rate": 0.0001,
                "mismatch_act_thres": 0.8,
                "mismatch_smoothing": 0.001,
                "branch_interval": 5000,
                "min_mismatch_deviation": 1.0,
                "accumulated_theta_thres": 2.0,
                "min_mismatch_percentage": 0.002,
                "inputs": [
                    {
                        "channel_name": "in_proximal",
                        "bank": "proximal"
                    }
                ],
                "random_seed": 0
            }
        }
    },
    "sim": {
        "nodes": [
            {
                "id": 0,
                "label": "mnist",
                "entity_type": "mnist_input",
                "entity_cfg": "default",
                "inputs": [],
                "random_seed_offset": 0
            },
            {
                "id": 1,
                "label": "ngm3 group",
                "entity_type": "ngm3_neuron_group",
                "entity_cfg": "L4-mnist-ngm3",
                "inputs": [
                    [
                        0,
                        "in_proximal"
                    ]
                ],
                "random_seed_offset": 0
            }
        ],
        "node_sets": []
    }
}
